<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<server description="defaultServer">
    <!--The Liberty Maven Plugin has generated Liberty features necessary for your application in configDropins/overrides/generated-features.xml-->
    <featureManager>
        <feature>webProfile-10.0</feature>
    </featureManager>
    <basicRegistry id="defaultBasicRegistry" realm="BasicRealm">
        <user name="username" password="password"/>
    </basicRegistry>
    <keyStore id="defaultKeyStore" password="password"/>
    <httpEndpoint host="*" httpPort="9082" httpsPort="9444" id="defaultHttpEndpoint"/>
    <webApplication contextRoot="/" location="fieldPal.war"/>

    <!--
        ═══ Conexión a PostgreSQL para JPA ═══
        Credenciales por variables de entorno (coinciden con docker-env):
        DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD

        Para desarrollo local sin Docker: levanta Postgres tú mismo y
        crea la base vacía (CREATE DATABASE fieldpal;) — las TABLAS las
        crea JPA/EclipseLink automáticamente al iniciar (ver persistence.xml).

        Para desarrollo con Docker: usa docker-compose-dev-pg.yml + docker-env
        (revisa el README para el comando exacto de docker compose con el
        archivo de variables docker-env) y exporta esas mismas variables
        antes de correr Liberty.

        El driver JDBC (postgresql-*.jar) se copia automáticamente a
        src/main/liberty/config/lib/ al ejecutar `mvn compile`
        (ver maven-dependency-plugin en pom.xml).
    -->
    <variable name="db.host"     defaultValue="localhost"        envVarName="DB_HOST"/>
    <variable name="db.port"     defaultValue="5435"             envVarName="DB_PORT"/>
    <variable name="db.name"     defaultValue="fieldpal"         envVarName="DB_NAME"/>
    <variable name="db.user"     defaultValue="fieldpaluser"     envVarName="DB_USER"/>
    <variable name="db.password" defaultValue="fieldpalUser2626" envVarName="DB_PASSWORD"/>

    <library id="postgresLib">
        <fileset dir="${server.config.dir}/lib" includes="postgresql-*.jar"/>
    </library>

    <dataSource id="fieldPalDS" jndiName="jdbc/fieldPalDS">
        <jdbcDriver libraryRef="postgresLib"/>
        <properties.postgresql
                url="jdbc:postgresql://${db.host}:${db.port}/${db.name}?stringtype=unspecified"
                user="${db.user}"
                password="${db.password}"/>
        <connectionManager minPoolSize="2" maxPoolSize="20" connectionTimeout="30s" maxIdleTime="10m"/>
    </dataSource>
</server>